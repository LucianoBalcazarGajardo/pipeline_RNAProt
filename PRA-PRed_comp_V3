cat << 'EOF' > run_pra.py
import os, subprocess, glob, sys, shutil, time

def extract_rna_sequence(pdb_file, rna_chain):
    seq = []
    last_res_num = None
    rna_map = {'A': 'A', 'U': 'U', 'G': 'G', 'C': 'C',
               'ADE': 'A', 'URA': 'U', 'GUA': 'G', 'CYT': 'C'}
    try:
        with open(pdb_file, 'r') as f:
            for line in f:
                if line.startswith("ATOM  ") or line.startswith("HETATM"):
                    chain = line[21]
                    if chain == rna_chain:
                        res_name = line[17:20].strip()
                        res_num = line[22:26].strip()
                        if res_num != last_res_num:
                            seq.append(rna_map.get(res_name, res_name))
                            last_res_num = res_num
        return "".join(seq)
    except Exception:
        return "ERROR_READING_SEQUENCE"

def process_model(full_path, batch_mode=False):
    dir_name = os.path.dirname(full_path)
    base_folder = os.path.basename(dir_name) if dir_name else "Root_Directory"
    
    if base_folder.startswith("PDB_"):
        protein_name = base_folder[4:]
    else:
        protein_name = base_folder
        
    pdb_name = os.path.basename(full_path)
    if pdb_name.endswith('.pdb'):
        pdb_name = pdb_name[:-4]
        
    if dir_name and dir_name != "Root_Directory":
        source_file = os.path.join(dir_name, pdb_name + ".pdb")
    else:
        source_file = pdb_name + ".pdb"
        
    local_file = pdb_name + ".pdb"

    # --- Función mejorada para registrar el TIPO de fallo en el CSV ---
    def write_error_to_csv(error_type):
        error_line = f"{protein_name};{pdb_name};{error_type};{error_type};{error_type};{error_type};{error_type}"
        header = "Protein;Model;Protein_Chain;RNA_Chain;RNA_Sequence;Delta_G(kcal/mol);Kd(M)\n"
        resultados_dir = "01_resultados" 
        os.makedirs(resultados_dir, exist_ok=True)
        
        master_csv_file = os.path.join(resultados_dir, "summary_general_PRA_Pred.csv")
        if not os.path.exists(master_csv_file):
            with open(master_csv_file, "w") as f: f.write(header)
        with open(master_csv_file, "a") as f: f.write(error_line + "\n")

        safe_name = protein_name.replace("/", "_").replace("\\", "_")
        protein_csv_file = os.path.join(resultados_dir, f"summary_{safe_name}.csv")
        if not os.path.exists(protein_csv_file):
            with open(protein_csv_file, "w") as f: f.write(header)
        with open(protein_csv_file, "a") as f: f.write(error_line + "\n")

    if not batch_mode:
        print(f"[{protein_name} -> {pdb_name}] Starting analysis...")
        
    if not os.path.exists(source_file):
        if not batch_mode: print(f"Error: Source file {source_file} not found.")
        write_error_to_csv("FILE_NOT_FOUND")
        return False

    old_folders = glob.glob("pr_res_*")
    for f in old_folders:
        shutil.rmtree(f, ignore_errors=True)

    copied = False
    if dir_name != "Root_Directory" and not os.path.exists(local_file):
        shutil.copy(source_file, local_file)
        copied = True

    input_data = f"pdb-file\n{pdb_name}\nss\n"
    
    result = subprocess.run(
        ["python3", "pdpredict_command.py"],
        input=input_data,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )

    folders = glob.glob("pr_res_*")
    
    if not folders:
        if copied: os.remove(local_file)
        if not batch_mode:
            print(f"\n[!] PRA-PRED ERROR WITH MODEL {pdb_name}")
            print(f"=== SYSTEM OUTPUT ===\n{result.stdout}")
            print(f"=== FOLDX/PYTHON ERROR ===\n{result.stderr}\n")
        write_error_to_csv("SYSTEM_CRASH")
        return False
        
    latest_folder = folders[0]
    result_file = os.path.join(latest_folder, "result.txt")
    
    if not os.path.exists(result_file):
        if copied: os.remove(local_file)
        shutil.rmtree(latest_folder, ignore_errors=True)
        if not batch_mode:
            print(f"\n[!] PRA-PRED ran but didn't generate result.txt in {pdb_name}")
        write_error_to_csv("SYSTEM_CRASH")
        return False
        
    with open(result_file, "r") as f:
        content = f.read().strip()
        
    for char in ["'", '"', "[", "]", "\\n", "\n", ","]:
        content = content.replace(char, " ")
        
    data = content.split()
    
    if len(data) < 5:
        if copied: os.remove(local_file)
        shutil.rmtree(latest_folder, ignore_errors=True)
        if not batch_mode:
            print(f"\n[!] SILENT ERROR: PRA-PRED created result.txt but it is empty/invalid for {pdb_name}.")
            print(f"=== SYSTEM OUTPUT ===\n{result.stdout}")
            print(f"=== FOLDX/PYTHON ERROR ===\n{result.stderr}\n")
        # Aquí marcamos específicamente el rechazo biológico/geométrico
        write_error_to_csv("GEOMETRY_ERROR")
        return False
        
    try:
        kd_float = float(data[4])
        data[4] = f"{kd_float:.2e}"
    except Exception:
        pass 
        
    rna_chain = data[2]
    rna_sequence = extract_rna_sequence(source_file, rna_chain)
    data.insert(0, protein_name)
    data.insert(4, rna_sequence)
        
    csv_line = ";".join(data)
    header = "Protein;Model;Protein_Chain;RNA_Chain;RNA_Sequence;Delta_G(kcal/mol);Kd(M)\n"
    
    resultados_dir = "01_resultados" 
    os.makedirs(resultados_dir, exist_ok=True)
    
    master_csv_file = os.path.join(resultados_dir, "summary_general_PRA_Pred.csv")
    if not os.path.exists(master_csv_file):
        with open(master_csv_file, "w") as f: f.write(header)
    with open(master_csv_file, "a") as f: f.write(csv_line + "\n")

    safe_name = protein_name.replace("/", "_").replace("\\", "_")
    protein_csv_file = os.path.join(resultados_dir, f"summary_{safe_name}.csv")
    if not os.path.exists(protein_csv_file):
        with open(protein_csv_file, "w") as f: f.write(header)
    with open(protein_csv_file, "a") as f: f.write(csv_line + "\n")
        
    if not batch_mode:
        print(f"[{pdb_name}] Success. Sequence extracted & data saved.")
        
    if copied: os.remove(local_file)
    shutil.rmtree(latest_folder, ignore_errors=True)
        
    return True

def format_time(seconds):
    h = int(seconds // 3600)
    m = int((seconds % 3600) // 60)
    s = int(seconds % 60)
    if h > 0: return f"{h}h {m}m {s}s"
    elif m > 0: return f"{m}m {s}s"
    return f"{s}s"

def process_directory(directory):
    models = glob.glob(os.path.join(directory, "*.pdb"))
    total = len(models)
    if total == 0:
        print(f"No PDB files found in directory '{directory}'")
        return
        
    print(f"\nFound {total} models in '{directory}'. Starting batch processing. \n")
    times = []
    successful = 0
    
    for i, model in enumerate(models, 1):
        name = os.path.basename(model)
        print(f"[{i}/{total}] Processing {name}... ", end="", flush=True)
        
        start_time = time.time()
        success = process_model(model, batch_mode=True)
        duration = time.time() - start_time
        times.append(duration)
        
        status = "OK" if success else "ERROR"
        if success: successful += 1
            
        avg_time = sum(times) / len(times)
        eta = avg_time * (total - i)
        
        print(f"{status} | Time: {format_time(duration)} | ETA: {format_time(eta)}")
        
    print(f"\nBatch complete! {successful}/{total} models processed successfully.")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("For a single model: python3 run_pra.py Folder/model.pdb")
        print("For a FOLDER (Batch): python3 run_pra.py Protein_Folder/")
        sys.exit(1)
        
    path = sys.argv[1]
    if os.path.isdir(path):
        process_directory(path)
    else:
        process_model(path)
EOF
